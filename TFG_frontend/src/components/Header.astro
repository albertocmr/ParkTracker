---
import NavLinksWrapper from "./NavLinksWrapper.jsx";

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-pine-900/5 bg-paper/80 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-4 sm:px-6 lg:h-[4.5rem]">
    <a href="/" class="group flex shrink-0 items-center gap-2.5">
      <img src="/logo-parktracker.png" alt="" class="h-8 w-8 transition-transform duration-300 group-hover:-rotate-6" />
      <span class="font-display text-xl font-semibold tracking-tight text-pine-950">ParkTracker</span>
    </a>

    <NavLinksWrapper currentPath={currentPath} client:only="react" />
  </div>
</header>
